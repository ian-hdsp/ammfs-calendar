# Copy to .env for local runs. NEVER commit .env -- it holds a live API key.
#
# In production none of this file is used. ZEFFY_API_KEY and FEED_TOKEN are
# GitHub Actions repository *secrets*; the tuning knobs below are repository
# *variables*. See .github/workflows/zeffy-calendar.yml.

# From Zeffy: Settings > Organization > Integrations > "Get my API key"
ZEFFY_API_KEY=

# Random token embedded in the published filename, which is what keeps the
# feed URL unguessable. Generate once and never change it -- changing it
# changes the URL and breaks everyone who already subscribed.
#   python -c "import secrets; print(secrets.token_hex(8))"
FEED_TOKEN=

# Where the Pages artifact is assembled, and the public base URL. In Actions
# both are set by the workflow; locally you only need them for a full run.
SITE_DIR=_site
FEED_BASENAME=zeffy-events
PAGES_BASE_URL=https://ian-hdsp.github.io/ammfs

# robots.txt telling crawlers to index nothing. It never names the feed file.
EMIT_ROBOTS=true

CALENDAR_NAME=American Made Miniatures Events
DEFAULT_TIMEZONE=America/New_York
DEFAULT_DURATION_MINUTES=120

# Advertised refresh hint. Apple Calendar and Thunderbird respect it;
# Google Calendar ignores it and refreshes every 8-24h regardless.
REFRESH_INTERVAL=PT30M
UID_DOMAIN=americanmademiniatures.org

# Set once discover.py tells you the real field names, e.g.
# ZEFFY_FIELD_MAP={"start":["eventStartsAt"],"location":["venueAddress"]}
ZEFFY_FIELD_MAP=

SYNC_ALL_CAMPAIGNS=false
PAST_WINDOW_DAYS=90
FUTURE_WINDOW_DAYS=730
DRY_RUN=false
